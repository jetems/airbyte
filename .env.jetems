# .env.jetems —— jetems 本地 docker-compose 环境变量默认值
# （见 docker-compose.jetems.yml）覆盖所有 airbyte server/cron/workers 启动所需的
# 无默认值/空默认值占位符，避免 Micronaut bean 初始化失败。
# 本地开发用，不含任何真实密钥。

# ─── 基础 ───
AIRBYTE_VERSION=dev
AIRBYTE_EDITION=ENTERPRISE
AIRBYTE_URL=http://server:8000
AIRBYTE_API_HOST=http://server:8000
INTERNAL_API_HOST=http://server:8001
WORKSPACE_ROOT=/tmp/airbyte_workspace
AIRBYTE_LICENSE_KEY=none

# ─── 数据库（与 docker-compose 的 postgres 一致）───
DATABASE_URL=jdbc:postgresql://postgres:5432/airbyte
DATABASE_USER=docker
DATABASE_PASSWORD=docker
CONFIG_DATABASE_REPLICA_URL=jdbc:postgresql://postgres:5432/airbyte
CONFIG_DATABASE_REPLICA_USER=docker
CONFIG_DATABASE_REPLICA_PASSWORD=docker
CONFIGS_DATABASE_MINIMUM_FLYWAY_MIGRATION_VERSION=0.40.0
JOBS_DATABASE_MINIMUM_FLYWAY_MIGRATION_VERSION=0.40.0

# ─── Temporal ───
TEMPORAL_HOST=temporal:7233

# ─── 存储（MinIO）───
STORAGE_TYPE=minio
STORAGE_BUCKET_LOG=airbyte-log
STORAGE_BUCKET_STATE=airbyte-state
STORAGE_BUCKET_WORKLOAD_OUTPUT=airbyte-workload-output
STORAGE_BUCKET_ACTIVITY_PAYLOAD=airbyte-activity-payload
STORAGE_BUCKET_AUDIT_LOGGING=airbyte-audit-logging
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
MINIO_ENDPOINT=http://minio:9000

# ─── K8s secret 禁用（docker-compose 无 K8s）───
AB_AUTH_SECRET_CREATION_ENABLED=false
SECRET_PERSISTENCE=NO_OP

# ─── 可选服务/集成（设占位值，避免空值阻塞 bean）───
ENTERPRISE_SOURCE_STUBS_URL=http://localhost:9999
MANIFEST_SERVER_API_HOST=http://localhost:9999
CONNECTOR_BUILDER_SERVER_API_HOST=http://localhost:9999
CONNECTOR_REGISTRY_BASE_URL=https://connectors.airbyte.com
AI_ASSIST_URL_BASE=http://localhost:9999
AIRBYTE_AGENTS_URL=http://localhost:9999
AIRBYTE_AGENTS_VALID_REDIRECT_URIS=*
AIRBYTE_AGENTS_WEB_ORIGINS=*
INTERNAL_RESOURCE_SECURITY_HEADER_CSP=
CORS_ALLOWED_ORIGINS_REGEX=.*

# ─── 认证（简单模式，非空占位）───
AB_JWT_SIGNATURE_SECRET=jetems-local-jwt-secret-0123456789
INITIAL_USER_EMAIL=admin@jetems.local
INITIAL_USER_FIRST_NAME=Admin
INITIAL_USER_LAST_NAME=Jetems

# ─── 功能开关 ───
FEATURE_FLAG_BASEURL=http://localhost:9999
DEFAULT_DATAPLANE_GROUP_NAME=default

# ─── 遥测/跟踪（禁用）───
TRACKING_STRATEGY=logging
LOG_LEVEL=INFO

# ─── Webapp 前端配置注入（空值可接受）───
WEBAPP_LAUNCHDARKLY_KEY=
WEBAPP_SEGMENT_TOKEN=
WEBAPP_FULLSTORY_ORG_ID=
WEBAPP_DATADOG_CLIENT_TOKEN=
WEBAPP_DATADOG_APPLICATION_ID=
INITIAL_USER_PASSWORD=jetems-local-admin
MICRONAUT_SECURITY_ENABLED=true
MICRONAUT_SECURITY_TOKEN_JWT_ENABLED=true
